{
  "description": "Asks before a Bash or PowerShell command can spend Databricks, Snowflake or dbt warehouse credits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hook.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
